    "@types/three": "^0.160.0",
    "@vitest/ui": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.30",
    "postcss": "^8.4.49",
    "postgres": "^3.4.9",
    "sharp": "^0.34.5",
