    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.49.1",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.26",
    "lucide-react": "^0.469.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "swr": "^2.4.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.160.1"
