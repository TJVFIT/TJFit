# Canonical URL for SEO (optional). On Vercel production, the custom domain is detected automatically.
# Set this for local builds or if metadata should always use a fixed host (e.g. https://tjfit.org).
NEXT_PUBLIC_SITE_URL=https://tjfit.org

# Google Search Console — HTML tag method: verification token, or full "google-site-verification=..." string.
GOOGLE_SITE_VERIFICATION=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin (server-side only - never use NEXT_PUBLIC_ for these)
# Admin email(s) - comma-separated. Users with these emails get full admin access.
ADMIN_EMAILS=admin@yourdomain.com

# Launch gate (server-side). When set to "coming-soon", non-admin visitors (incl. logged-in non-admins)
# are redirected to /coming-soon. Admins (per ADMIN_EMAILS) bypass and use the site normally.
# Bypass paths: /coming-soon, /api/*, /robots.txt, /sitemap.xml, /{locale}/{login|signup|forgot-password|verify-email}.
# Leave empty to disable (full public site).
LAUNCH_GATE=

# TJAI (server-side only - never use NEXT_PUBLIC_)
# OpenAI API key for TJAI plan generation (GPT-4o). Get it from platform.openai.com/api-keys
OPENAI_API_KEY=

# ── TJAI open-LLM gateway (src/lib/tjai/llm-gateway.ts) ──────────────────
# The provider-agnostic switch (owner directive 2026-07-14: move off OpenAI).
# Set PRESET (ollama | lmstudio | groq | openrouter | together | vllm) or a
# raw BASE_URL. When either is set, the gateway wins over the legacy
# OpenAI/Anthropic policy for every task. Owner path: Groq free tier
# (console.groq.com) or local Ollama with ONE pinned model (qwen3:8b).
# Undocumented since July — surfaced by the 2026-08 env audit (WP-SEC-08).
TJAI_LLM_PRESET=
TJAI_LLM_BASE_URL=
TJAI_LLM_API_KEY=
TJAI_LLM_MODEL=
# Optional second-pass plan critique (plan-generation-pipeline.ts). "off" to skip.
TJAI_PLAN_REFINE=
# When true, reject generated plans if summary calories/protein drift too far from server-computed metrics (staging recommended).
TJAI_STRICT_PLAN_VALIDATION=false
# Verbose TJAI pipeline / chat context logs (timings, stages). Avoid in production unless debugging.
TJAI_DEBUG_PIPELINE=false
# Anthropic Claude API key. Required for blog-generate, meal-prep,
# swap-meal, grocery-list, pro-renewal-email, long-memory, and adaptive
# suggestions — these use Claude where its strengths matter (the rest
# of TJAI runs on OpenAI). If unset, those specific endpoints return
# 500; chat is unaffected. Get it from console.anthropic.com.
ANTHROPIC_API_KEY=

# Gumroad — merchant of record for programs / diets / TJAI credit
# packs / subscriptions (v5 payment automation).
# - GUMROAD_SELLER_ID: your account's seller id, shown in Gumroad at
#   Settings → Advanced under the Ping endpoint ("For external
#   services, your seller_id is ..."). The webhook verifies that every
#   incoming notification carries this id. Set the Ping notification
#   URL to https://tjfit.org/api/webhooks/gumroad.
# - GUMROAD_API_KEY: Bearer token for outbound calls (product
#   create/update, sale lookup, refund). Get one from
#   https://app.gumroad.com/settings/advanced. ALSO required by the
#   webhook: every sale is re-verified against the Gumroad API by
#   sale_id before any credits/access are granted (anti-forgery).
# Without these, the webhook returns 503 and the admin sync buttons
# throw a config error. The catalog still browses fine.
GUMROAD_SELLER_ID=
GUMROAD_API_KEY=
# Bundle checkout fallback — a Gumroad product URL used only when a bundle has
# no row in the bundle_gumroad_products table (the 10 paid bundles are mapped in DB).
GUMROAD_DEFAULT_PRODUCT_URL=
# Subscription checkout URLs (public). These activate the Pro / Apex membership
# CTAs — until set, the subscribe buttons stay disabled. Create the 4 membership
# products in Gumroad, then paste each product's share/short URL here.
#   Pro  = monthly + annual ; Apex = monthly + annual (prices in src/lib/tjai-pricing.ts)
NEXT_PUBLIC_GUMROAD_PRO_MONTHLY_URL=
NEXT_PUBLIC_GUMROAD_PRO_ANNUAL_URL=
NEXT_PUBLIC_GUMROAD_APEX_MONTHLY_URL=
NEXT_PUBLIC_GUMROAD_APEX_ANNUAL_URL=

# Email — Resend (server-side only). Required for transactional emails (welcome, renewal, newsletters).
# Get your key at https://resend.com
RESEND_API_KEY=
# From-address for transactional email, e.g. "TJFit <noreply@tjfit.org>". Must be a
# verified sender/domain in Resend, or sends fail.
RESEND_FROM_EMAIL=
# Inbox that support / contact-form messages are routed to.
SUPPORT_INBOX=
# Secret used to sign unsubscribe tokens in newsletter emails (any random string).
EMAIL_UNSUBSCRIBE_SECRET=

# Coach terms of use version (bump to force re-acceptance for coaches only).
COACH_TERMS_VERSION=1.0

# Payments (server-only). resolvePaymentBackend() picks the checkout backend; create-order returns clientFlow.
# Gumroad is the only live payment rail (Paddle was removed at commit 44f26a7) — configure the bundle
# and subscription product URLs in the Gumroad block above.
# PAYMENT_PROVIDER: unset (or "gumroad") → Gumroad hosted checkout. Unset + ALLOW_TEST_CHECKOUT=true →
# test mode (no real charges). Use none|off to disable checkout entirely.
ALLOW_TEST_CHECKOUT=false
#
# Global promo codes (any logged-in user). Percent discount applied to the order total at checkout.
# Option A — JSON (can be awkward in some host UIs):
# CHECKOUT_PROMO_CODES={"JOSEPH1407":99}
CHECKOUT_PROMO_CODES=
# Option B — no JSON (recommended on Vercel): comma-separated CODE:PERCENT
# CHECKOUT_PROMO_PAIRS=JOSEPH1407:99
CHECKOUT_PROMO_PAIRS=
# Option C — single code as two plain vars:
# CHECKOUT_PROMO_CODE=JOSEPH1407
# CHECKOUT_PROMO_PERCENT=99
CHECKOUT_PROMO_CODE=
CHECKOUT_PROMO_PERCENT=

# Marketing pixels (optional — TrackingScripts loads only when set; wire CMP/consent before production ads)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Sentry (optional - errors are no-op if not set)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────────────────────────────────────────────────────────────────────
# Cron + scheduled jobs
# ─────────────────────────────────────────────────────────────────────────
# Shared secret required by /api/cron and /api/community/challenges/settle.
# Set the same value in your scheduler (Vercel Cron, GitHub Actions, etc.)
# and pass as ?secret=… or in the request body. Without this, scheduled
# endpoints reject all incoming requests with 401.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Payments (extra)
# ─────────────────────────────────────────────────────────────────────────
# Explicit payment-backend override. Valid: gumroad | test | none | off
# Unset (or "gumroad") → Gumroad. Unset + ALLOW_TEST_CHECKOUT=true → test mode (no real charges).
PAYMENT_PROVIDER=

# ─────────────────────────────────────────────────────────────────────────
# Rate limiting (Upstash Redis — recommended for production)
# ─────────────────────────────────────────────────────────────────────────
# REST URL + token from Upstash console (https://console.upstash.com).
# Without these the in-memory fallback runs (single-instance only, resets
# on cold start) — fine for dev, NOT recommended for production traffic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# Anthropic model overrides (optional)
# ─────────────────────────────────────────────────────────────────────────
# Override the model IDs TJAI uses for Opus / Sonnet / Haiku endpoints.
# Defaults are reasonable; override only to A/B newer snapshots.
ANTHROPIC_MODEL_OPUS=
ANTHROPIC_MODEL_SONNET=
ANTHROPIC_MODEL_HAIKU=

# ─────────────────────────────────────────────────────────────────────────
# TJAI text-to-speech (ElevenLabs) — optional
# ─────────────────────────────────────────────────────────────────────────
# Without an API key the /api/tjai/tts endpoint returns 503.
ELEVENLABS_API_KEY=
# Default voice model. Cheap + fast: eleven_turbo_v2_5.
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Price per 1M chars (USD) — used for credit cost accounting. Default 30.
ELEVENLABS_PRICE_PER_M_CHARS=30

# ─────────────────────────────────────────────────────────────────────────
# Translation provider (community blogs, custom-program imports) — optional
# ─────────────────────────────────────────────────────────────────────────
# When unset, the translate endpoints fall back to the built-in heuristic
# pass-through. Provide a custom MT endpoint + key here to upgrade quality.
TRANSLATE_API_URL=
TRANSLATE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Email signing — secondary secrets (optional, with safe fallbacks)
# ─────────────────────────────────────────────────────────────────────────
# Separate signing secret for newsletter confirmation tokens. Falls back to
# EMAIL_UNSUBSCRIBE_SECRET / NEXTAUTH_SECRET / a default constant — set
# this in production so the chain is deterministic.
NEWSLETTER_CONFIRM_SECRET=
# Generic fallback used by email-preferences when EMAIL_UNSUBSCRIBE_SECRET
# is unset. Carried over from a prior NextAuth setup; OK to leave blank.
NEXTAUTH_SECRET=

# ─────────────────────────────────────────────────────────────────────────
# Pricing tier feature flags (locale-aware paid tiers)
# ─────────────────────────────────────────────────────────────────────────
# Toggle Tier 2 / Tier 3 paid offerings for the current build. Public flags;
# safe in NEXT_PUBLIC_. Default off — set "true" to enable.
NEXT_PUBLIC_TIER_2_LIVE=
NEXT_PUBLIC_TIER_3_LIVE=

# ─────────────────────────────────────────────────────────────────────────
# Optional / internal
# ─────────────────────────────────────────────────────────────────────────
# Legacy TJCOIN behavior flag (internal). Leave blank unless migrating old coin data.
TJFIT_COIN_LEGACY=

# ─────────────────────────────────────────────────────────────────────────
# Migration drift check (scripts/db/check-migration-drift.ts, WP-SEC-08)
# ─────────────────────────────────────────────────────────────────────────
# Read-only Supabase Management API PAT + project ref used ONLY by
# `npm run db:drift` to fetch the applied-migrations ledger for comparison
# against the repo's supabase/migrations/*.sql. Not read by the app itself
# — CI/local tooling only. Alternative: pass --ledger-file <path.json>.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
